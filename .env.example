# .env.example — 키 이름만 커밋한다. 실제 값은 .env 에 넣고 .env 는 커밋하지 않는다.
# 사용법: cp .env.example .env  →  값 채우기  →  uv run --env-file .env python main.py

# ─────────────────────────────────────────────
# LLM 공급자 선택
#   openai | anthropic | google_genai
#   (langchain init_chat_model 의 model_provider 값과 같다)
# ─────────────────────────────────────────────
LLM_PROVIDER=anthropic

# 작업별로 다른 공급자를 쓰고 싶을 때만 지정 (비우면 LLM_PROVIDER 사용)
#   GENERATION = 과제 생성 그래프 / EVALUATION = 제출물 평가 그래프
GENERATION_LLM_PROVIDER=
EVALUATION_LLM_PROVIDER=

# ─────────────────────────────────────────────
# OpenAI (GPT)
#   모델 ID 는 https://developers.openai.com/api/docs/models 에서 확인 후 기입
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ─────────────────────────────────────────────
# Anthropic (Claude)
#   claude-opus-5-5 (기본) / claude-sonnet-5-5 (저렴) / claude-haiku-5-5 (최저가)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─────────────────────────────────────────────
# Google (Gemini)
#   https://ai.google.dev/gemini-api/docs/models 에서 최신 ID 확인
# ─────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
